# Ollama (for local inference)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Logging
# LOG_LEVEL=INFO              # INFO/DEBUG/WARNING/ERROR
# LOG_FILE=logs/myagent.log   # Set specific file path
# LOG_TO_FILE=true            # Or auto-generate with datetime

# Reasoning traces (for models like deepseek-r1, qwq)
# SHOW_REASONING=true         # Parse <think> tags and show in UI

# Config files (optional)
# AGENTS_CONFIG_PATH=src/agents_config/agents.json
# PROMPTS_CONFIG_PATH=src/agents_config/prompts.json

# Inline document context (when text is small enough)
# INLINE_DOC_MAX_CHARS=20000

# PDF ingestion and caching settings
# All documents are cached in SQLite for unified access. JSON export is optional.
# PDF_SQLITE_DIR=data          # Directory for SQLite database files (default 'data')
# PDF_STORAGE_DIR=data/pdfs    # Directory for permanent PDF file storage
# PDF_JSON_DIR=data            # Directory for optional JSON export of small documents
# PDF_JSON_MAX_BYTES=2000000   # Max file size for JSON export (default 2MB)
# USE_ENRICHMENT=true          # Enable LLM page enrichment during ingestion
# SHOW_INGESTION_LOGS=false    # Show per-page progress during enrichment in UI

# OpenRouter API (for cloud inference backend)
# OPENROUTER_API_KEY=sk-or-xxxxx

# Personal info for validation agent (dynamic JSON)
# Supports any fields: name, email, phone, address, company, dob, etc.
# PERSONAL_INFO_JSON={"name": "John Doe", "email": "john@example.com", "company": "Acme Corp", "dob": "1990-01-15"}
