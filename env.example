# Ollama (for local inference)
OLLAMA_BASE_URL=http://localhost:11434/v1

# Default models (referenced by agents.json via ${VAR})
# Set these and use "${DEFAULT_MID}" / "${DEFAULT_HIGH}" / "${DEFAULT_LIGHT}"
# in the model fields of src/agents_config/agents.json.
# DEFAULT_MODEL=google/gemma-2-9b-it
# DEFAULT_LIGHT=google/gemma-2-2b-it
# DEFAULT_MID=google/gemma-2-9b-it
# DEFAULT_HIGH=google/gemma-2-27b-it

# Evaluation run defaults (overridable per-run in the Evaluation tab)
# EVAL_CONCURRENCY=1                # Max annotations run in parallel
# EVAL_MAX_SAMPLES=                 # Cap on annotations per run (empty = no cap)
# EVAL_SHUFFLE=false                # Shuffle annotations before running
# EVAL_SEED=                        # Random seed used when shuffling
# EVAL_CONTEXT_MODE=full_doc        # full_doc | spans_only | question_only

# LLM-as-judge defaults (overridable per-run in the Judge Run tab)
# JUDGE_CONCURRENCY=1               # Max (prediction × metric) judgments in parallel.
                                     # >1 only helps remote backends (OpenRouter); local Ollama should stay at 1.

# App display name (shown in UI)
# ASSISTANT_NAME=Doc2Agent

# Logging
# LOG_LEVEL=INFO              # INFO/DEBUG/WARNING/ERROR
# LOG_FILE_PREFIX=Doc2Agent   # Prefix for auto-named log file: logs/{prefix}_{YYYYMMDD_HHMMSS}.log
# LOG_TO_FILE=true            # Write logs to file (default: true)
# LOG_TO_STDOUT=false         # Also stream logs to terminal (opt-in)
# Startup prints the resolved log file path.

# Reasoning traces (for models like deepseek-r1, qwq)
# SHOW_REASONING=true         # Parse <think> tags and show in UI

# Config files (optional)
# AGENTS_CONFIG_PATH=src/agents_config/agents.json
# PROMPTS_CONFIG_PATH=src/agents_config/prompts.json

# Inline document context (when text is small enough)
# INLINE_DOC_MAX_CHARS=20000

# PDF ingestion and caching settings
# All documents are cached in SQLite for unified access. JSON export is optional.
# PDF_SQLITE_DIR=data          # Directory for SQLite database files (default 'data')
# PDF_STORAGE_DIR=data/pdfs    # Directory for permanent PDF file storage
# PDF_JSON_DIR=data            # Directory for optional JSON export of small documents
# PDF_JSON_MAX_BYTES=2000000   # Max file size for JSON export (default 2MB)
# USE_ENRICHMENT=true          # Enable LLM page enrichment during ingestion
# SHOW_INGESTION_LOGS=false    # Show per-page progress during enrichment in UI

# OpenRouter API (for cloud inference backend)
# OPENROUTER_API_KEY=sk-or-xxxxx

# Personal info for validation agent (dynamic JSON)
# Supports any fields: name, email, phone, address, company, dob, etc.
# PERSONAL_INFO_JSON={"name": "John Doe", "email": "john@example.com", "company": "Acme Corp", "dob": "1990-01-15"}

# Query caching settings
# QUERY_CACHE_ENABLED=true          # Enable/disable query caching (default: true)
# QUERY_CACHE_MAX_PER_FILE=10       # Max cached queries per document (default: 10)
