{
  "default_backend": "local",
  "backends": {
    "local": {
      "type": "ollama",
      "base_url": "http://localhost:11434/v1"
    },
    "openrouter": {
      "type": "openrouter",
      "api_key_env": "OPENROUTER_API_KEY"
    }
  },
  "agents": {
    "main": {
      "model": "anthropic/claude-sonnet-4.6",
      "temperature": 0.2,
      "backend": "openrouter",
      "max_turns": 12
    },
    "reviewer": {
      "model": "deepseek/deepseek-v3.2",
      "temperature": 0.1,
      "backend": "openrouter",
      "max_turns": 6
    },
    "validator": {
      "model": "deepseek/deepseek-v3.2",
      "temperature": 0.1,
      "backend": "openrouter",
      "max_turns": 8
    },
    "ingestion": {
      "model": "deepseek/deepseek-v3.2",
      "temperature": 0.0,
      "backend": "openrouter",
      "max_turns": 1
    },
    "judge": {
      "model": "deepseek/deepseek-v3.2",
      "temperature": 0.0,
      "backend": "openrouter",
      "max_turns": 1
    }
  }
}