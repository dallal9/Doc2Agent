{
  "default_backend": "local",
  "backends": {
    "local": {
      "type": "ollama",
      "base_url": "http://localhost:11434/v1"
    },
    "openrouter": {
      "type": "openrouter",
      "api_key_env": "OPENROUTER_API_KEY"
    }
  },
  "agents": {
    "main": {
      "model": "ministral-3:3b",
      "temperature": 0.2,
      "backend": "local"
    },
    "reviewer": {
      "model": "ministral-3:3b",
      "temperature": 0.1,
      "backend": "local"
    }
  }
}

